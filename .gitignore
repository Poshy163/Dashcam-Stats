# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Application data — never commit a database or anyone's footage
data/
*.db
*.db-wal
*.db-shm
models/*.bin
models/*.xml
models/*.onnx

# Test fixtures are generated by backend/scripts/make_fixtures.py rather than committed.
# They are synthetic, but regenerating them keeps the repository free of binary video.
tests/fixtures/*.ts
tests/fixtures/*.mp4

# Learned OSD glyph templates are device-specific and regenerated on demand
*.npz

# Local environment / secrets. Nothing here is ever committed.
.env
.env.*
!.env.example
*.pem
*.key
credentials*
smb*.conf

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
